# Payment service database (docker-compose postgres; host port 5433 locally).
DATABASE_URL="postgresql://payment_db_user:service_password@localhost:5433/payment_db?schema=public"
# HTTP port (webhook, mock gateway, queries).
PORT="3300"
# Kafka / Redpanda brokers (comma-separated).
KAFKA_BROKERS="localhost:9092"
# Gateway and channel of new payments: MOCK | VNPAY | VIETQR_VA; QR_CODE | DOMESTIC_BANK | INTERNATIONAL_CARD | BANK_TRANSFER.
PAYMENT_DEFAULT_GATEWAY="MOCK"
PAYMENT_DEFAULT_CHANNEL="QR_CODE"
# MOCK gateway: webhooks carry hex(HMAC-SHA256(raw body, MOCK_GATEWAY_SECRET)) in x-webhook-signature.
MOCK_GATEWAY_SECRET="local-mock-gateway-secret-change-me"
MOCK_GATEWAY_BASE_URL="https://mock-gateway.local"
# VNPay (skeleton adapter; required only when VNPAY is used).
# VNPAY_TMN_CODE=""
# VNPAY_HASH_SECRET=""
# VNPAY_RETURN_URL="https://shop.example/payments/vnpay/return"
# VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# VietQR virtual accounts (skeleton adapter; required only when VIETQR_VA is used).
# VIETQR_WEBHOOK_SECRET=""
# VIETQR_BANK_BIN="970422"
# VIETQR_ACCOUNT_PREFIX="VQR"
# VIETQR_ACCOUNT_NAME="ECOMMERCE"
# Exposes POST /payments/mock-gateway/pay (signs and delivers a webhook). Never enable in production.
MOCK_GATEWAY_ENABLED="true"
# Outbox polling period.
OUTBOX_RELAY_INTERVAL_MS="1000"
# Process roles (all default to true). Split API and workers by deploying the same image twice:
#   API pods:    HTTP_ENABLED=true,  OUTBOX_RELAY_ENABLED=false, KAFKA_CONSUMERS_ENABLED=false
#   Worker pods: HTTP_ENABLED=false, OUTBOX_RELAY_ENABLED=true,  KAFKA_CONSUMERS_ENABLED=true
HTTP_ENABLED="true"
OUTBOX_RELAY_ENABLED="true"
KAFKA_CONSUMERS_ENABLED="true"
# Swagger UI at /api/docs and OpenAPI JSON at /api/docs-json; disable on public production endpoints.
SWAGGER_ENABLED="true"
# Kafka consumers: attempts before a message is parked in <topic>.dlq, and the first retry backoff (doubled).
KAFKA_CONSUMER_MAX_ATTEMPTS="5"
KAFKA_CONSUMER_RETRY_BACKOFF_MS="200"
