# Order service database (docker-compose postgres; host port from POSTGRES_HOST_PORT, 5433 locally).
DATABASE_URL="postgresql://order_db_user:service_password@localhost:5433/order_db?schema=public"
# Idempotency store (docker-compose redis, password from REDIS_PASSWORD).
REDIS_URL="redis://:redis_password@localhost:6379"
# Inventory gRPC service.
INVENTORY_GRPC_HOST="localhost"
INVENTORY_GRPC_PORT="50051"
# Kafka / Redpanda brokers (comma-separated) for the outbox relay.
KAFKA_BROKERS="localhost:9092"
# Outbox polling period.
OUTBOX_RELAY_INTERVAL_MS="1000"
# Process roles (all default to true). Split API and workers by deploying the same image twice:
#   API pods:    HTTP_ENABLED=true,  OUTBOX_RELAY_ENABLED=false, KAFKA_CONSUMERS_ENABLED=false
#   Worker pods: HTTP_ENABLED=false, OUTBOX_RELAY_ENABLED=true,  KAFKA_CONSUMERS_ENABLED=true
HTTP_ENABLED="true"
OUTBOX_RELAY_ENABLED="true"
KAFKA_CONSUMERS_ENABLED="true"
# Swagger UI at /api/docs and OpenAPI JSON at /api/docs-json; disable on public production endpoints.
SWAGGER_ENABLED="true"
# Kafka consumers: attempts before a message is parked in <topic>.dlq, and the first retry backoff (doubled).
KAFKA_CONSUMER_MAX_ATTEMPTS="5"
KAFKA_CONSUMER_RETRY_BACKOFF_MS="200"
