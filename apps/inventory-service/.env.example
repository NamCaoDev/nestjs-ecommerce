# Inventory service database (docker-compose postgres; host port 5433 locally).
DATABASE_URL="postgresql://inventory_db_user:service_password@localhost:5433/inventory_db?schema=public"
# Stock counters and reservations (docker-compose redis).
REDIS_URL="redis://:redis_password@localhost:6379"
# gRPC server port (consumed by order-service).
INVENTORY_GRPC_PORT="50051"
# HTTP port (smoke test).
PORT="3200"
# Kafka / Redpanda brokers (comma-separated).
KAFKA_BROKERS="localhost:9092"
# Lifetime of an uncommitted reservation and sweep period (lower them to exercise the sweeper locally).
RESERVATION_TTL_SECONDS="900"
RESERVATION_SWEEP_INTERVAL_MS="30000"
# Process roles (all default to true). Split API and workers by deploying the same image twice:
#   API pods:    HTTP_ENABLED=true,  RESERVATION_SWEEPER_ENABLED=false, KAFKA_CONSUMERS_ENABLED=false
#   Worker pods: HTTP_ENABLED=false, RESERVATION_SWEEPER_ENABLED=true,  KAFKA_CONSUMERS_ENABLED=true
HTTP_ENABLED="true"
RESERVATION_SWEEPER_ENABLED="true"
KAFKA_CONSUMERS_ENABLED="true"
# Swagger UI at /api/docs and OpenAPI JSON at /api/docs-json; disable on public production endpoints.
SWAGGER_ENABLED="true"
