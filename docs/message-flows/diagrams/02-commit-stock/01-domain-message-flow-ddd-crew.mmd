flowchart LR
  Gateway([Payment gateway]):::actor
  Payment[Payment]:::context
  Relay([Payment outbox relay, every 1 s]):::actor
  Inventory[Inventory]:::context
  Ordering[Ordering]:::context
  Gateway -- "1. event: signed webhook SUCCESS (flow 09)" --> Payment
  Relay -- "2. command: RelayOutbox (internal)" --> Payment
  Payment -- "3. event: payment.succeeded (Kafka payments.events, key = orderId)" --> Inventory
  Inventory -- "4. command: CommitStock (internal)" --> Inventory
  Inventory -. "5. event: stock.reservation_failed (only when expired AND out of stock)" .-> Ordering
  classDef actor fill:#fef3c7,stroke:#b45309,color:#000
  classDef context fill:#e5e7eb,stroke:#374151,color:#000
